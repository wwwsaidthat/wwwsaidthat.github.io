# Never commit the real value. Generate a long random string on the server.
MCNE_API_KEY=replace-with-a-long-random-api-key

# auto: use CUDA when available; cuda: require CUDA; cpu: force CPU.
DEVICE_MODE=auto

# GitHub Pages origin plus optional local preview origin.
ALLOWED_ORIGINS=https://wwwsaidthat.github.io,http://localhost:8000

# Cora will be downloaded here on the first run if it is not already present.
DATA_ROOT=/app/data/Cora
CHECKPOINT_ROOT=/app/checkpoints
